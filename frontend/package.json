{
  "name": "kyivair-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "KyivAir — фронтенд: карта AQI за районами Києва",
  "scripts": {
    "start": "npx --yes http-server -p 8080 -c-1 .",
    "test": "node --test tests/unit/*.test.js",
